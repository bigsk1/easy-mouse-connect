{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Mouse Connect",
  "version": "0.4.1",
  "identifier": "io.easymouseconnect.desktop",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Easy Mouse Connect",
      "width": 1180,
      "height": 850,
      "minWidth": 760,
      "minHeight": 600,
      "center": true,
      "backgroundColor": "#141719",
      "dragDropEnabled": true
    }],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Encrypted keyboard and mouse sharing between Windows PCs",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
